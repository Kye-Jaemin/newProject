{
  "name": "quizduel-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run test/unit",
    "test:rules": "firebase emulators:exec --only firestore --project demo-quizduel \"vitest run test/rules\"",
    "validate:questions": "tsx scripts/validate-questions.ts ../content/questions"
  },
  "dependencies": {
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^6.6.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "firebase": "^12.0.0",
    "firebase-tools": "^15.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
